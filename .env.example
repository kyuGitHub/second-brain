# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요. (.env 는 GitHub 에 올라가지 않아요)
# Supabase 대시보드 → Project Settings → API 에서 확인. 어드민 제너레이터와 같은 프로젝트를 써도 돼요.
# Vercel 에도 Settings → Environment Variables 에 같은 이름으로 등록하세요.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 노트 올리기(deploy.bat)용 내 계정. brain_members 에 can_upload = true 로 등록된 이메일이어야 해요.
SB_EMAIL=
# 비워 두면 올릴 때마다 비밀번호를 물어봐요. (정기 자동 배포를 할 때만 채우세요)
SB_PASSWORD=
