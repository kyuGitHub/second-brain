    "보고": "procedural",
    "참고": "entity",
    "원문": "entity",
    "교정로그": "reflective"
  },
  "typeLabels": {
    "thesis": "색인(MOC)",
    "semantic": "주제·요구사항",
    "episodic": "회의·인터뷰",
    "procedural": "사업·보고",
    "entity": "참고자료",
    "reflective": "기타",
    "topic": "대분류"
  },
  "fields": {
    "topics": [
      "topics",
      "대분류"
    ],
    "tags": [
      "tags",
      "태그"
    ],
    "dates": [
      "date",
      "updated",
      "created",
      "작성일"
    ]
  },
  "categories": [
    {
      "key": "type",
      "label": "문서 유형",
      "field": "type"
    },
    {
      "key": "biz",
      "label": "업무 영역",
      "field": "업무"
    },
    {
      "key": "domain",
      "label": "대분류 › 중분류",
      "field": [
        "대분류",
        "중분류",
        "소분류"
      ]
    },
    {
      "key": "tag",
      "label": "태그",
      "field": "태그",
      "split": "/"
    },
    {
      "key": "folder",
      "label": "폴더",
      "field": "$folder"
    }
  ],
  "propFields": [
    "요구사항ID",
    "요구정의명",
    "업무",
    "대분류",
    "중분류",
    "소분류",
    "기능묶음",
    "관련부서",
    "적용구분",
    "개발유형",
    "처리결과",
    "근거회의",
    "updated"
  ],
  "folderTypes": {},
  "features": {
    "categories": true,
    "search": true,
    "reader": true
  },
  "linkRules": [
    {
      "sourceField": "업무",
      "equals": "상위요구사항",
      "as": "parent"
    },
    {
      "sourceType": "thesis",
      "as": "index"
    },
    {
      "sourceType": "episodic",
      "as": "meeting"
    },
    {
      "targetType": "episodic",
      "as": "evidence"
    },
    {
      "bothHave": "요구사항ID",
      "as": "related"
    }
  ]
